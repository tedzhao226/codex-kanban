{
  "name": "codex-kanban",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local Kanban board for existing native Codex chats.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node server.mjs",
    "dev": "node --watch server.mjs",
    "test": "node --test",
    "check": "for file in server.mjs lib/*.mjs public/*.js scripts/*.mjs test/*.mjs; do node --check \"$file\" || exit; done",
    "test:browser": "node scripts/verify-diagrams.mjs",
    "test:time-filter": "node scripts/verify-time-filter.mjs",
    "test:board:browser": "node scripts/verify-board.mjs"
  },
  "dependencies": {
    "dompurify": "3.4.15",
    "marked": "18.0.13",
    "mermaid": "11.17.2"
  }
}
