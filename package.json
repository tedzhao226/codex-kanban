{
  "name": "codex-kanban",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "bin": { "codex-kanban": "bin/codex-kanban.mjs" },
  "description": "A local Kanban board and CLI for native Codex tasks.",
  "files": [
    "ARCHITECTURE.md",
    "README.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "docs/**",
    "bin/**",
    "lib/**",
    "public/**",
    "scripts/check-syntax.mjs",
    "server.mjs"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node server.mjs",
    "dev": "node --watch server.mjs",
    "cli": "node bin/codex-kanban.mjs",
    "probe:shared-server": "node scripts/probe-shared-app-server.mjs",
    "probe:native-setup": "node scripts/probe-native-task-setup.mjs",
    "test": "node --test",
    "check": "node scripts/check-syntax.mjs",
    "test:browser": "node scripts/verify-diagrams.mjs",
    "test:time-filter": "node scripts/verify-time-filter.mjs",
    "test:board:browser": "node scripts/verify-board.mjs"
  },
  "dependencies": {
    "dompurify": "3.4.15",
    "marked": "18.0.13",
    "mermaid": "11.17.2"
  }
}
